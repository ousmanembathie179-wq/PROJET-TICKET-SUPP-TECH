<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tableau de bord Technicien</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>

<body class="bg-light">
    <%- include('partials/header-tech') %>
        <main class="container-fluid px-md-5 py-4 bg-light min-vh-100">

            <div class="row g-4 mb-5">
                <div class="col-12 col-md-4">
                    <div class="card border-0 shadow-sm p-4 text-center rounded-4 bg-white">
                        <span class="text-secondary fw-semibold d-block mb-2">Tickets Ouverts</span>
                        <div class="d-flex justify-content-center align-items-center gap-3">
                            <span class="fs-3">🔓</span>
                            <span class="display-6 fw-bold text-danger">12</span>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card border-0 shadow-sm p-4 text-center rounded-4 bg-white">
                        <span class="text-secondary fw-semibold d-block mb-2">En Cours</span>
                        <div class="d-flex justify-content-center align-items-center gap-3">
                            <span class="fs-3">⚙️</span>
                            <span class="display-6 fw-bold text-primary">5</span>
                        </div>
                    </div>
                </div>
                <div class="col-12 col-md-4">
                    <div class="card border-0 shadow-sm p-4 text-center rounded-4 bg-white">
                        <span class="text-secondary fw-semibold d-block mb-2">Résolus</span>
                        <div class="d-flex justify-content-center align-items-center gap-3">
                            <span class="fs-3">✅</span>
                            <span class="display-6 fw-bold text-success">45</span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
                <div>
                    <a href="/admin/utilisateurs" class="text-decoration-none fw-semibold">&larr; Gestion
                        d'utilisateurs</a>
                </div>
                <div class="text-center">
                    <h4 class="fw-bold m-0 text-dark">Tableau des tickets</h4>
                </div>
                <div>
                    <a href="/technicien/Nouveau-Ticket" class="btn btn-primary px-4 py-2 rounded-3 fw-semibold">Nouveau
                        Ticket</a>
                </div>
            </div>

            <div class="row g-3 mb-4 align-items-center">
                <div class="col-6 col-md-2">
                    <button id="btnSupprimer" form="formSuppression" class="btn btn-danger w-100 rounded-3 py-2 fw-semibold d-none" type="submit">Supprimer</button>
                </div>
                <div class="col-12 col-md-6 offset-md-1">
    <form method="GET" action="">
        <div class="position-relative">
            <input type="text" name="search" class="form-control rounded-pill ps-4 pe-5 py-2-5 border-0 shadow-sm"
                   placeholder="Rechercher un ticket" value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>">
            <button type="submit" class="btn position-absolute top-50 end-0 translate-middle-y me-2 bg-transparent border-0">
                <i class="fas fa-search text-secondary">🔍</i>
            </button>
        </div>
    </form>
</div>
            </div>

            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="table-responsive">
                    <form id="formSuppression" action="/supprimer-tickets-tech" method="POST">
                        <table class="table table-bordered align-middle mb-0 text-center bg-white">
                        <thead class="table-light text-secondary fw-bold">
                            <tr>
                                <th style="width: 120px;"><input type="checkbox" class="form-check-input me-2" id="toutCocher"> (Tout
                                    cocher)</th>
                                <th>ID <i class="fas fa-sort text-muted ms-1">↕</i></th>
                                <th>Titre du problème <i class="fas fa-sort text-muted ms-1">↕</i></th>
                                <th>Auteur <i class="fas fa-sort text-muted ms-1">↕</i></th>
                                <th>Priorité <i class="fas fa-sort text-muted ms-1">↕</i></th>
                                <th>Date <i class="fas fa-sort text-muted ms-1">↕</i></th>
                                <th>Statut <i class="fas fa-sort text-muted ms-1">↕</i></th>
                                <th>Action <i class="fas fa-sort text-muted ms-1">↕</i></th>
                            </tr>
                        </thead>
                        <tbody class="fw-medium text-dark">
                            <% listeTickets.forEach(function(ticket) { %>
                                <tr>
                                    <td><input type="checkbox" class="form-check-input ticket-checkbox" name="id_ticket"
                                            value="<%= ticket.id_ticket %>"></td>
                                    <td>
                                        <%= ticket.id_ticket %>
                                    </td>
                                    <td class="text-start ps-3">
                                        <%= ticket.titre %>
                                    </td>

                                    <td>
                                        <%= ticket.auteur_prenom %>
                                            <%= ticket.auteur_nom %>
                                    </td>

                                    <td
                                        class="<%= (ticket.libelle_priorite === 'Moyenne') ? 'table-primary text-primary' : (ticket.libelle_priorite === 'Haute') ? 'table-danger text-danger' : 'table-success text-success' %> fw-bold">
                                        <%= ticket.libelle_priorite %>
                                    </td>

                                    <td>
                                        <%= ticket.date_creation.toLocaleDateString() %>
                                    </td>

                                    <td>
                                        <% let sClass=(ticket.libelle_statut==="Ouvert" ) ? "bg-danger text-white" :
                                            (ticket.libelle_statut==="En cours" ) ? "bg-info text-dark"
                                            : "bg-success text-white" ; %>
                                            <span class="badge <%= sClass %> px-3 py-2 rounded-2 w-100">
                                                <%= ticket.libelle_statut %>
                                            </span>
                                    </td>

                                    <td><a href="/technicien/GererTicket/<%= ticket.id_ticket %>"
                                            class="text-decoration-none fw-bold">Gérer</a></td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                    </form>
                </div>
            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-center mt-4 gap-3">
                <span class="text-secondary fw-semibold">Affichage 1-4 sur 45 tickets</span>
                <div class="btn-group shadow-sm">
                    <button class="btn btn-outline-secondary bg-white text-muted border-end-0 px-3">&lt;
                        Précédent</button>
                    <button class="btn btn-primary px-4">Suivant &gt;</button>
                </div>
            </div>

        </main>
        <script>
    const checkboxes = document.querySelectorAll('.ticket-checkbox');
    const btnSupprimer = document.getElementById('btnSupprimer');
    const toutCocher = document.getElementById('toutCocher');

    // Fonction pour afficher/masquer le bouton Supprimer
    function gererBoutonSupprimer() {
        const isAnyChecked = Array.from(checkboxes).some(cb => cb.checked);
        if (isAnyChecked) {
            btnSupprimer.classList.remove('d-none');
        } else {
            btnSupprimer.classList.add('d-none');
        }
    }

    // Événement sur les cases individuelles
    checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', gererBoutonSupprimer);
    });

    // Événement sur la case "Tout cocher"
    if (toutCocher) {
        toutCocher.addEventListener('change', function() {
            const etatCoche = this.checked;
            
            // On coche ou décoche toutes les lignes
            checkboxes.forEach(cb => {
                cb.checked = etatCoche;
            });
            
            // On met à jour le bouton
            gererBoutonSupprimer();
        });
    }
</script>
</body>

</html>